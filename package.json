{
  "name": "observatoire-ville",
  "version": "0.1.0",
  "private": true,
  "description": "Observatoire de la ville : conception des indicateurs, carte mentale, données",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite --config client/vite.config.ts client",
    "build": "vite build --config client/vite.config.ts client",
    "start": "node server/index.js",
    "seed:reset": "node server/seed.js --reset",
    "seed:build": "python tools/build_seed.py"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
