# Copier ce fichier en « .env » à côté de docker-compose.yml (le fichier .env n'est jamais versionné).
# Assistant IA (onglet « IA ») : clé de l'API Groq, https://console.groq.com/keys
GROQ_API_KEY=
# Modèle utilisé (compatible appels de fonctions)
GROQ_MODEL=llama-3.3-70b-versatile
# Autre fournisseur compatible OpenAI (facultatif)
# IA_BASE_URL=https://api.groq.com/openai/v1
