# Copier ce fichier en « .env » à côté de docker-compose.yml (le fichier .env n'est jamais versionné),
# puis relancer : docker compose up -d
# L'onglet « IA » ne fait que choisir entre Groq et l'IA locale : toute la configuration est ici.

# --- Groq (en ligne) : clé sur https://console.groq.com/keys ---
GROQ_API_KEY=
# Modèle (doit gérer les appels de fonctions)
GROQ_MODEL=llama-3.3-70b-versatile

# --- IA locale : serveur Ollama ou vLLM exposant l'API compatible OpenAI ---
# Ollama : http://hôte:11434      vLLM : http://hôte:8000 (lancé avec --enable-auto-tool-choice et un --tool-call-parser)
# Depuis Docker, « localhost » désigne le conteneur : utiliser l'adresse IP ou le nom du serveur du modèle.
LOCAL_LLM_KIND=ollama
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
# Jeton si le serveur en exige un (vLLM --api-key)
LOCAL_LLM_API_KEY=

# Fournisseur proposé par défaut : groq ou local (sinon : Groq s'il est configuré, sinon l'IA locale)
# IA_PROVIDER=groq

# --- API centrale APM (services transverses : AD, mail, sms, oracle…) ---
# Clé X-API-KEY de 64 caractères fournie par l'administrateur APM (permissions ad_auth, ad_read…).
APM_API_URL=https://api.ivry.local
APM_API_KEY=

# --- Certificat TLS auto-signé de l'API centrale ---
# L'API https://api.ivry.local est protégée par un certificat auto-signé : un appel HTTPS standard
# échoue (self-signed certificate / DEPTH_ZERO_SELF_SIGNED_CERT). Fournir l'autorité interne de la
# Ville (recommandé) OU accepter l'auto-signé pour ces seuls appels. Ne jamais désactiver la
# vérification TLS globalement (NODE_TLS_REJECT_UNAUTHORIZED=0).
# Chemin du .pem/.crt de l'autorité interne fourni par la DSI :
VILLE_CA_FILE=
# Repli : accepte le certificat auto-signé UNIQUEMENT pour les appels à l'API centrale.
VILLE_ALLOW_SELF_SIGNED_CERTS=true

# API Entreprise (DINUM) : fiches « association » de la DJEPVA, accès habilité réservé à la Ville (données NON PUBLIQUES)
API_ENTREPRISE_URL=https://entreprise.api.gouv.fr
API_ENTREPRISE_KEY=
# SIRET du destinataire des appels (siège de la commune), facultatif : 21940041300015 par défaut
# API_ENTREPRISE_RECIPIENT=
# communes analysées en plus d'Ivry (codes INSEE séparés par des virgules) : associations dont le siège est dans chaque commune
# API_ENTREPRISE_COMMUNES=94081,94076
